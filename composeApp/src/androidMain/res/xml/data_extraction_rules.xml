<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer: same rule as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="patrimonio-auth.preferences_pb" />
        <exclude domain="file" path="patrimonio-cloud.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="patrimonio-auth.preferences_pb" />
        <exclude domain="file" path="patrimonio-cloud.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
